# Copy to .env for local `docker compose up`. In Coolify, set these under Environment Variables.
DB_NAME=trendevents
DB_USER=trenduser
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-another-strong-password
